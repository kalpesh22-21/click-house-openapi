# ============================================================
# ClickHouse REST API / MCP Server — environment variable reference
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ============================================================

# ------------------------------------------------------------
# ClickHouse connection (all required unless a default is shown)
# ------------------------------------------------------------

# Hostname or IP of your ClickHouse server
CLICKHOUSE_HOST=clickhouse.example.com

# ClickHouse HTTP(S) port.  Default: 8443 (HTTPS).  Use 8123 for plain HTTP.
CLICKHOUSE_PORT=8443

# ClickHouse credentials
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# Default database selected on every connection.  Default: default
CLICKHOUSE_DATABASE=default

# Set to false only for local/dev clusters without TLS.  Default: true
CLICKHOUSE_SECURE=true

# ------------------------------------------------------------
# API authentication (external JWT / OIDC)
# ------------------------------------------------------------
#
# Clients present a signed JWT as a Bearer token.  The app verifies the
# signature against the IdP's JWKS, checks iss/aud/exp/nbf, and pins the
# allowed signing algorithms.  All three OIDC_* values are REQUIRED for the
# REST API and the MCP HTTP transport (the server fails closed at startup if
# they are unset).  MCP stdio transport performs no auth (local-trust model)
# and needs none of these.

# JWKS endpoint that publishes the IdP's public signing keys.
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# Expected token issuer (the JWT 'iss' claim).
OIDC_ISSUER=https://idp.example.com/

# Expected audience for this API (the JWT 'aud' claim).
OIDC_AUDIENCE=clickhouse-api

# Optional static PEM public key for an external token creator that mints
# RS*/ES*/PS* JWTs but publishes NO JWKS endpoint.  When set it verifies tokens
# directly (no network) and takes precedence over OIDC_JWKS_URL, so you can leave
# OIDC_JWKS_URL blank.  Escaped '\n' are normalised, so a one-line secret works.
# A single key only — key rotation needs a JWKS endpoint.
# OIDC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"

# Comma-separated allowlist of accepted signing algorithms.  Asymmetric only;
# 'none' and HMAC (HS*) are rejected to prevent algorithm-confusion attacks.
# Default: RS256
JWT_ALGORITHMS=RS256

# ------------------------------------------------------------
# OAuth 2.0 Protected Resource Metadata (MCP Authorization / RFC 9728)
# ------------------------------------------------------------
#
# Lets interactive MCP clients (Claude Desktop, ChatGPT, MCP Inspector, VS Code)
# discover the authorization server and obtain a token via authorization-code +
# PKCE, instead of an operator hand-minting a JWT.  The MCP HTTP server publishes
# GET /.well-known/oauth-protected-resource and answers 401s with a
# WWW-Authenticate: Bearer resource_metadata="..." challenge.  Token VALIDATION
# is unchanged — these only advertise where to log in.  See docs/oauth.md.
#
# The authorization server is an external IdP (validated via OIDC_* above).
# PUBLIC_BASE_URL must be the real public HTTPS URL of the MCP server.

# Authorization server issuer URL(s), comma-separated.  Each must serve OIDC /
# RFC 8414 discovery metadata.  Defaults to OIDC_ISSUER when empty.
#   Azure Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
# OAUTH_AUTHORIZATION_SERVERS=https://login.microsoftonline.com/<tenant-id>/v2.0

# Canonical resource identifier advertised as PRM 'resource' (RFC 8707 audience
# binding).  MUST equal the audience the IdP stamps as the token 'aud' claim
# (i.e. match OIDC_AUDIENCE).  Defaults to PUBLIC_BASE_URL + MCP_PATH when empty.
#   Azure Entra ID:  api://<api-app-client-id>
# OAUTH_RESOURCE=api://<api-app-client-id>

# Optional scopes advertised in PRM 'scopes_supported', comma-separated.
# OAUTH_SCOPES_SUPPORTED=Query.Read

# ------------------------------------------------------------
# Per-tenant row-level isolation
# ------------------------------------------------------------
#
# JSON object mapping a ClickHouse custom-setting name to the JWT claim that
# fills it.  Each authenticated query injects settings[ch_setting]=jwt[claim]
# via the trusted settings= channel (never concatenated into SQL).  ClickHouse
# row policies read getSetting('paycom_client_code') (and the proc-center /
# authenticated-user settings) to filter rows per tenant.
#
# Keys must start with CLICKHOUSE_CUSTOM_SETTINGS_PREFIX and must not shadow a
# safety setting (readonly / max_*).  Default maps the three settings the
# warehouse row policies read from the verified JWT claims:
CLICKHOUSE_TENANT_SETTINGS={"paycom_client_code": "clientcode", "paycom_proc_center": "proc_center", "paycom_authenticated_user": "jti"}

# Required prefix for tenant custom-setting keys.  MUST match the ClickHouse
# server's <custom_settings_prefixes> configuration.  Default: paycom_
CLICKHOUSE_CUSTOM_SETTINGS_PREFIX=paycom_

# ClickHouse readonly level applied to every query (1 or 2).  readonly=1 works
# with the per-tenant paycom_* settings, PROVIDED the ClickHouse server
# registers the prefix:  <custom_settings_prefixes>paycom_</custom_settings_prefixes>.
# The app sends the row/time caps itself, so they hold regardless.  2 is rarely
# needed. Default: 1.
CLICKHOUSE_READONLY=1

# Apply ClickHouse `final=1` to every query so ReplacingMergeTree /
# CollapsingMergeTree tables return their collapsed (latest) rows instead of
# un-merged duplicates.  WARNING: query-global — FINAL applies to every
# MergeTree-family table in a query, not just Replacing ones, so plain MergeTree
# tables pay the merge-at-read cost and large scans may newly hit
# MAX_EXECUTION_TIME.  No-ops on system tables.  Default: true (correctness-first;
# set false only if the warehouse has no Replacing/Collapsing tables).
CLICKHOUSE_SELECT_FINAL=true

# ------------------------------------------------------------
# Query safety limits
# ------------------------------------------------------------

# Maximum wall-clock time (seconds) a single query may run.  Default: 30
MAX_EXECUTION_TIME=30

# ClickHouse-side hard cap on the number of result rows returned.  Default: 10000
MAX_RESULT_ROWS=10000

# ClickHouse-side cap on rows read (scanned) per query.  Default: 100000000
MAX_ROWS_TO_READ=100000000

# LIMIT injected automatically when the query has no LIMIT clause.  Default: 1000
DEFAULT_LIMIT=1000

# Maximum rows included in the API JSON response.  Default: 1000
# Results beyond this count are dropped and truncated=true is set in the response.
MAX_RESPONSE_ROWS=1000

# ------------------------------------------------------------
# Schema access control
# ------------------------------------------------------------

# Comma-separated list of ClickHouse databases this API is allowed to access.
# Use * to permit all databases (default).
# Example: ALLOWED_DATABASES=analytics,reporting,dwh
ALLOWED_DATABASES=*

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# Port the uvicorn server listens on inside the container.  Default: 8000
APP_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.  Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------
# OpenAPI / ChatGPT GPT Action
# ------------------------------------------------------------

# Public HTTPS base URL included in the OpenAPI servers block.
# ChatGPT reads this from GET /openapi.json to know where to send requests.
# Must be an HTTPS URL reachable from the internet when used as a GPT Action.
PUBLIC_BASE_URL=https://your-public-host.example.com

# ------------------------------------------------------------
# Mode selection (REST API vs MCP server)
# ------------------------------------------------------------

# Server mode: 'api' starts the REST/FastAPI server (default), 'mcp' starts
# the MCP server.  Used by entrypoint.sh and the Helm chart.
MODE=api

# ------------------------------------------------------------
# MCP server configuration
# ------------------------------------------------------------

# MCP transport:
#   stdio       — for local desktop clients (Claude Desktop, etc.).
#                 No authentication required; relies on local subprocess trust.
#   http        — streamable-HTTP for remote/k8s deployments.
#                 A valid OIDC JWT is required on every request.
# Default: stdio
MCP_TRANSPORT=stdio

# Port the MCP HTTP server listens on (only used when MCP_TRANSPORT=http).
# Default: 8000 (same as APP_PORT)
MCP_PORT=8000

# URL path for the MCP streamable-HTTP endpoint.
# Default: /mcp
MCP_PATH=/mcp

# ------------------------------------------------------------
# HashiCorp Vault (sensitive-value sourcing) — optional
# ------------------------------------------------------------
#
# When VAULT_ENABLED=true, the values below are read from Vault at startup and
# OVERRIDE the plaintext env values above.  Leave VAULT_ENABLED=false (default) to
# keep using the plain env vars.  Each *_PATH points at a KV secret; a path left
# empty skips that group (its env/default value is kept).  Requires the internal
# 'paycompy' package; the app refuses to boot if VAULT_ENABLED=true without it.
# Vault client connection itself is configured via the standard VAULT_ADDR /
# VAULT_TOKEN (or role) environment variables read by paycompy.
VAULT_ENABLED=false

# KV path holding the ClickHouse connection secret.
# Expected keys: CLICKHOUSE_HOST, CLICKHOUSE_PORT, CLICKHOUSE_USER, CLICKHOUSE_PASSWORD
CLICKHOUSE_CREDS_PATH=

# KV path holding the static OIDC public key.  Expected key: OIDC_PUBLIC_KEY
# NB: a public key is not confidential — sourced from Vault only for central
# management / tamper-resistance, not secrecy.  Validated as PEM on load.
OIDC_PUBLIC_KEY_VAULT_PATH=

# KV path holding the scratch-writer ClickHouse credential.
# Expected keys: SCRATCH_CH_USER, SCRATCH_CH_PASSWORD
SCRATCH_CH_CREDS_PATH=

# KV path holding the security-writer ClickHouse credential.
# Expected keys: SECURITY_CH_USER, SECURITY_CH_PASSWORD
SECURITY_CH_CREDS_PATH=

# KV path holding the employee-access Redis URL.  Expected key: REDIS_URL
REDIS_VAULT_PATH=
