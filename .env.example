# ============================================================
# ClickHouse REST API / MCP Server — environment variable reference
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ============================================================

# ------------------------------------------------------------
# ClickHouse connection (all required unless a default is shown)
# ------------------------------------------------------------

# Hostname or IP of your ClickHouse server
CLICKHOUSE_HOST=clickhouse.example.com

# ClickHouse HTTP(S) port.  Default: 8443 (HTTPS).  Use 8123 for plain HTTP.
CLICKHOUSE_PORT=8443

# ClickHouse credentials
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# Default database selected on every connection.  Default: default
CLICKHOUSE_DATABASE=default

# Set to false only for local/dev clusters without TLS.  Default: true
CLICKHOUSE_SECURE=true

# ------------------------------------------------------------
# API authentication (external JWT / OIDC)
# ------------------------------------------------------------
#
# Clients present a signed JWT as a Bearer token.  The app verifies the
# signature against the IdP's JWKS, checks iss/aud/exp/nbf, and pins the
# allowed signing algorithms.  All three OIDC_* values are REQUIRED for the
# REST API and the MCP HTTP transport (the server fails closed at startup if
# they are unset).  MCP stdio transport performs no auth (local-trust model)
# and needs none of these.

# JWKS endpoint that publishes the IdP's public signing keys.
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# Expected token issuer (the JWT 'iss' claim).
OIDC_ISSUER=https://idp.example.com/

# Expected audience for this API (the JWT 'aud' claim).
OIDC_AUDIENCE=clickhouse-api

# Comma-separated allowlist of accepted signing algorithms.  Asymmetric only;
# 'none' and HMAC (HS*) are rejected to prevent algorithm-confusion attacks.
# Default: RS256
JWT_ALGORITHMS=RS256

# ------------------------------------------------------------
# Admin authentication (static API key)
# ------------------------------------------------------------
#
# The /admin CSV-ingest write routes are an internal operational path, not a
# per-tenant LLM surface, so they authenticate with a single shared API key
# (Bearer) instead of a JWT.  This is the value the admin UI's "API Key" field
# sends.  require_admin_api_key fails closed (503) if it is empty, so set it
# whenever the /admin routes are exposed.  Generate one with: openssl rand -hex 32
API_KEY=your-strong-random-admin-api-key

# ------------------------------------------------------------
# Per-tenant row-level isolation
# ------------------------------------------------------------
#
# JSON object mapping a ClickHouse custom-setting name to the JWT claim that
# fills it.  Each authenticated query injects settings[ch_setting]=jwt[claim]
# via the trusted settings= channel (never concatenated into SQL).  ClickHouse
# row policies read getSetting('SQL_tenant') to filter rows per tenant.
#
# Keys must start with CLICKHOUSE_CUSTOM_SETTINGS_PREFIX and must not shadow a
# safety setting (readonly / max_*).  Default: {"SQL_tenant": "user_name"}
CLICKHOUSE_TENANT_SETTINGS={"SQL_tenant": "user_name"}

# Required prefix for tenant custom-setting keys.  MUST match the ClickHouse
# server's <custom_settings_prefixes> configuration.  Default: SQL_
CLICKHOUSE_CUSTOM_SETTINGS_PREFIX=SQL_

# ClickHouse readonly level applied to every query (1 or 2).  readonly=1 works
# with the per-tenant SQL_tenant setting, PROVIDED the ClickHouse server
# registers the prefix:  <custom_settings_prefixes>SQL_</custom_settings_prefixes>.
# The app sends the row/time caps itself, so they hold regardless.  2 is rarely
# needed. Default: 1.
CLICKHOUSE_READONLY=1

# ------------------------------------------------------------
# Query safety limits
# ------------------------------------------------------------

# Maximum wall-clock time (seconds) a single query may run.  Default: 30
MAX_EXECUTION_TIME=30

# ClickHouse-side hard cap on the number of result rows returned.  Default: 10000
MAX_RESULT_ROWS=10000

# ClickHouse-side cap on rows read (scanned) per query.  Default: 100000000
MAX_ROWS_TO_READ=100000000

# LIMIT injected automatically when the query has no LIMIT clause.  Default: 1000
DEFAULT_LIMIT=1000

# Maximum rows included in the API JSON response.  Default: 1000
# Results beyond this count are dropped and truncated=true is set in the response.
MAX_RESPONSE_ROWS=1000

# ------------------------------------------------------------
# Schema access control
# ------------------------------------------------------------

# Comma-separated list of ClickHouse databases this API is allowed to access.
# Use * to permit all databases (default).
# Example: ALLOWED_DATABASES=analytics,reporting,dwh
ALLOWED_DATABASES=*

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# Port the uvicorn server listens on inside the container.  Default: 8000
APP_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.  Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------
# OpenAPI / ChatGPT GPT Action
# ------------------------------------------------------------

# Public HTTPS base URL included in the OpenAPI servers block.
# ChatGPT reads this from GET /openapi.json to know where to send requests.
# Must be an HTTPS URL reachable from the internet when used as a GPT Action.
PUBLIC_BASE_URL=https://your-public-host.example.com

# ------------------------------------------------------------
# Mode selection (REST API vs MCP server)
# ------------------------------------------------------------

# Server mode: 'api' starts the REST/FastAPI server (default), 'mcp' starts
# the MCP server.  Used by entrypoint.sh and the Helm chart.
MODE=api

# ------------------------------------------------------------
# MCP server configuration
# ------------------------------------------------------------

# MCP transport:
#   stdio       — for local desktop clients (Claude Desktop, etc.).
#                 No authentication required; relies on local subprocess trust.
#   http        — streamable-HTTP for remote/k8s deployments.
#                 A valid OIDC JWT is required on every request.
# Default: stdio
MCP_TRANSPORT=stdio

# Port the MCP HTTP server listens on (only used when MCP_TRANSPORT=http).
# Default: 8000 (same as APP_PORT)
MCP_PORT=8000

# URL path for the MCP streamable-HTTP endpoint.
# Default: /mcp
MCP_PATH=/mcp

# ------------------------------------------------------------
# Token service (MODE=token) — the issuer that mints per-user JWTs
# ------------------------------------------------------------
#
# Run with MODE=token (uvicorn app.token_service:create_app --factory).  It signs
# JWTs and publishes JWKS; the API above validates them.  TOKEN_ISSUER /
# TOKEN_AUDIENCE MUST equal this file's OIDC_ISSUER / OIDC_AUDIENCE.

# iss/aud stamped on issued tokens (match OIDC_ISSUER / OIDC_AUDIENCE above).
TOKEN_ISSUER=https://token.example.com/
TOKEN_AUDIENCE=clickhouse-api

# Default token lifetime (seconds) and signing algorithm.
TOKEN_TTL_SECONDS=3600
TOKEN_ALGORITHM=RS256

# Signing key — supply ONE (file preferred for a mounted Secret).  Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing-key.pem
# TOKEN_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\n...      # inline PEM
TOKEN_SIGNING_KEY_FILE=/etc/token-service/signing-key.pem

# Optional explicit JWKS key id; derived from the key (RFC 7638) when empty.
TOKEN_KID=

# Static Bearer key required to call POST /token (minting is privileged).
TOKEN_ISSUER_API_KEY=your-strong-random-issuer-api-key

# Local dev only: generate an ephemeral key and leave /token unauthenticated.
# NEVER true with >1 replica or in production.
TOKEN_DEV_MODE=false
